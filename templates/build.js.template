// build.js template for analyze-video
//
// Replace placeholders below before running:
//   __OUT_DIR__     -> absolute path to session outputs (no trailing slash)
//   __DOC_TITLE__   -> the document title (e.g., "GitHub Films Visual Analysis")
//   __FILENAME__    -> the .docx filename (e.g., "gh_dungeons_analysis.docx")
//
// Then push the per-video sections into the `children` array using h1(),
// meta(), h2(), body(), imgPara(), and cap() helpers.
//
// Critical docx rules (do NOT remove these):
//   - type: 'jpg' is required on every ImageRun
//   - altText with all three fields (title, description, name) is required
//   - Never use \n inside a TextRun, use separate Paragraph elements
//   - Page size 12240 x 15840 DXA = US Letter
//   - 1440 DXA margin = 1 inch

const { Document, Packer, Paragraph, TextRun, ImageRun } = require('docx');
const fs = require('fs');

const OUT = '__OUT_DIR__';

// ---------- Helpers ----------

function imgPara(filePath, dim) {
  // dim: { width: number, height: number } in points
  // 16:9 default = { width: 480, height: 270 }
  // 4:3          = { width: 480, height: 360 }
  // 9:16 vert    = { width: 240, height: 427 }
  return new Paragraph({
    spacing: { before: 220, after: 0 },
    children: [new ImageRun({
      type: 'jpg',
      data: fs.readFileSync(filePath),
      transformation: dim || { width: 480, height: 270 },
      altText: { title: 'frame', description: 'video frame', name: 'frame' }
    })]
  });
}

function cap(text) {
  return new Paragraph({
    spacing: { before: 60, after: 280 },
    children: [new TextRun({ text, italics: true, size: 18, color: '777777', font: 'Arial' })]
  });
}

function body(text) {
  return new Paragraph({
    spacing: { before: 0, after: 180 },
    children: [new TextRun({ text, size: 22, font: 'Arial' })]
  });
}

function h1(text) {
  return new Paragraph({
    spacing: { before: 440, after: 180 },
    children: [new TextRun({ text, bold: true, size: 36, font: 'Arial', color: '1A1A1A' })]
  });
}

function h2(text) {
  return new Paragraph({
    spacing: { before: 300, after: 120 },
    children: [new TextRun({ text, bold: true, size: 24, font: 'Arial', color: '2D6A9F' })]
  });
}

function meta(text) {
  return new Paragraph({
    spacing: { before: 0, after: 260 },
    children: [new TextRun({ text, italics: true, size: 20, color: '888888', font: 'Arial' })]
  });
}

function title(text) {
  return new Paragraph({
    spacing: { before: 0, after: 120 },
    children: [new TextRun({ text, bold: true, size: 44, font: 'Arial', color: '0D0D0D' })]
  });
}

// ---------- Content ----------

const children = [
  title('__DOC_TITLE__'),
  meta('Generated by /analyze-video'),

  // For each video, push:
  //   h1('Video Title'),
  //   meta('Uploader · Duration · Source URL'),
  //   h2('Opening (0:00-0:15)'),
  //   body('...analysis prose...'),
  //   imgPara(`${OUT}/video_1/frames/frame_0001.jpg`, { width: 480, height: 270 }),
  //   cap('Caption describing what is shown.'),
  //   ...
  //
  // For multi-video runs, end with:
  //   h1('Observations Across Videos'),
  //   body('...shared patterns...'),
];

// ---------- Document ----------

const doc = new Document({
  sections: [{
    properties: {
      page: {
        size: { width: 12240, height: 15840 }, // US Letter
        margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 }
      }
    },
    children
  }]
});

Packer.toBuffer(doc).then(buf => {
  fs.writeFileSync(`${OUT}/__FILENAME__`, buf);
  console.log(`wrote ${OUT}/__FILENAME__`);
}).catch(err => { console.error(err); process.exit(1); });
